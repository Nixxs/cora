Screen {
    background: #141820;
}

#chat-panel {
    height: 1fr;
    background: #141820;
    border: round #7799cc;
    padding: 0 1;
}

#chat-output {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

#status-bar {
    height: 1;
    margin: 0;
    padding: 0 1;
}

#chat-status {
    width: 1fr;
    height: 1;
    color: #8f98a8;
}

#mic-status {
    width: auto;
    height: 1;
    color: #8f98a8;
}

#input-frame {
    height: 3;
    margin-top: 0;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#chat-input {
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #141820;
    color: #e0e6ef;
}

#chat-input:focus {
    border: none;
    background: #141820;
    background-tint: transparent;
}