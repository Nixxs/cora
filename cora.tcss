Screen {
    background: #141820;
}

Screen > .screen--selection {
    color: #f3f6fb;
    background: #31557a;
}

#chat-panel, #dashboard-panel {
    height: 1fr;
    background: #141820;
    border: round #7799cc;
    border-top: none;
    padding: 0 1;
}

#chat-output {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

#activity-panel {
    height: auto;
    margin: 1 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

#activity-panel > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #8f98a8;
    text-style: none;
}

#activity-panel > CollapsibleTitle:hover,
#activity-panel > CollapsibleTitle:focus {
    background: #202838;
    color: #e0e6ef;
}

#activity-panel.activity-error > CollapsibleTitle {
    color: #f0a38a;
}

#activity-panel > Contents {
    padding: 0;
}

#activity-output {
    height: 6;
    margin-top: 1;
    padding: 0 1;
    background: #10141b;
    color: #8f98a8;
    scrollbar-size: 1 1;
}

#status-bar {
    height: 1;
    margin: 0;
    padding: 0 1;
}

#chat-status {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: transparent;
    content-align: left middle;
    text-align: left;
    text-style: none;
    text-opacity: 100%;
    color: #8f98a8;
}

#chat-status.state-active {
    color: #8fcca6;
}

#chat-status.state-active:hover, #chat-status.state-active:focus,
#chat-status.state-standby:hover, #chat-status.state-standby:focus {
    background: #202838;
}

#chat-status.state-standby {
    color: #a6acd8;
}

#chat-status.state-connecting, #chat-status.state-disconnecting {
    color: #e0c080;
}

#mic-status, #speaker-status, #wake-status {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0 0 0 2;
    padding: 0;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#mic-status:hover, #mic-status:focus,
#speaker-status:hover, #speaker-status:focus,
#wake-status:hover, #wake-status:focus {
    background: #202838;
    color: #e0e6ef;
}

#mic-status.audio-muted, #speaker-status.audio-muted {
    color: #f0a38a;
}

#wake-status.wake-listening {
    color: #8fcca6;
}

#speaker-status {
    width: 12;
    text-align: left;
}

#speaker-level {
    width: 8;
    height: 1;
    margin-left: 1;
    content-align: center middle;
    color: #8fcca6;
}

#speaker-level.audio-muted {
    color: #f0a38a;
}

#input-frame {
    height: auto;
    margin-top: 0;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#chat-input {
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #141820;
    color: #e0e6ef;
    scrollbar-size: 1 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#chat-input:focus {
    border: none;
    background: #141820;
    background-tint: transparent;
}

#title-bar {
    height: 1;
    background: #141820;
}

#title-bar .title-line {
    width: auto;
    color: #7799cc;
}

#title-fill {
    width: 1fr;
    height: 1;
    color: #7799cc;
}

#view-button, #settings-button, #close-button {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #7799cc;
}

#view-button:hover, #view-button:focus,
#settings-button:hover, #settings-button:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#close-button:hover,
#close-button:focus {
    background: #202838;
    color: #f0a38a;
    text-style: none;
}

#dashboard-top {
    height: 11;
}

.dashboard-row {
    height: 1fr;
}

.dashboard-box {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: round #415575;
    border-title-color: #8f98a8;
}

#voice-box {
    width: 2fr;
}

#speaker-graph, #mic-graph {
    height: 1fr;
}

#speaker-graph {
    color: #8fcca6;
}

#mic-graph {
    color: #a6acd8;
}

#voice-axis {
    height: 1;
    color: #415575;
}

ModelSettingsScreen {
    align: center middle;
    background: #141820 70%;
}

#model-settings {
    width: 48;
    height: auto;
    padding: 0 2 1 2;
    background: #141820;
    border: round #7799cc;
}

#model-settings-title {
    width: 1fr;
    margin: 1 0 0 0;
    color: #e0e6ef;
    text-style: bold;
}

.model-settings-label {
    margin: 1 0 0 0;
    color: #8f98a8;
}

#model-settings Select {
    width: 1fr;
}

#model-settings-close {
    margin: 1 0 0 0;
    width: 1fr;
}