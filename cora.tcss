Screen {
    background: #141820;
}

Screen > .screen--selection {
    color: #f3f6fb;
    background: #31557a;
}

#chat-panel, #dashboard-panel {
    height: 1fr;
    background: #141820;
    border: round #7799cc;
    border-top: none;
    padding: 0 1;
}

#chat-output {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

#activity-panel {
    height: auto;
    margin: 1 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

#activity-panel > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #8f98a8;
    text-style: none;
}

#activity-panel > CollapsibleTitle:hover,
#activity-panel > CollapsibleTitle:focus {
    background: #202838;
    color: #e0e6ef;
}

#activity-panel.activity-error > CollapsibleTitle {
    color: #f0a38a;
}

#activity-panel > Contents {
    padding: 0;
}

#activity-output {
    height: 6;
    margin-top: 1;
    padding: 0 1;
    background: #10141b;
    color: #8f98a8;
    scrollbar-size: 1 1;
}

#status-bar {
    height: 1;
    margin: 0;
    padding: 0 1;
}

#chat-status {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: transparent;
    content-align: left middle;
    text-align: left;
    text-style: none;
    text-opacity: 100%;
    color: #8f98a8;
}

#chat-status.state-active {
    color: #8fcca6;
}

#chat-status.state-active:hover, #chat-status.state-active:focus,
#chat-status.state-standby:hover, #chat-status.state-standby:focus {
    background: #202838;
}

#chat-status.state-standby {
    color: #a6acd8;
}

#chat-status.state-connecting, #chat-status.state-disconnecting {
    color: #e0c080;
}

#mic-status, #speaker-status, #wake-status {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0 0 0 2;
    padding: 0;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#mic-status:hover, #mic-status:focus,
#speaker-status:hover, #speaker-status:focus,
#wake-status:hover, #wake-status:focus {
    background: #202838;
    color: #e0e6ef;
}

#mic-status.audio-muted, #speaker-status.audio-muted {
    color: #f0a38a;
}

#wake-status.wake-listening {
    color: #8fcca6;
}

#speaker-status {
    width: 12;
    text-align: left;
}

#speaker-level {
    width: 8;
    height: 1;
    margin-left: 1;
    content-align: center middle;
    color: #8fcca6;
}

#speaker-level.audio-muted {
    color: #f0a38a;
}

#input-frame {
    height: auto;
    margin-top: 0;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#chat-input, #dashboard-input {
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #141820;
    color: #e0e6ef;
    scrollbar-size: 1 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#chat-input:focus, #dashboard-input:focus {
    border: none;
    background: #141820;
    background-tint: transparent;
}

#title-bar {
    height: 1;
    background: #141820;
}

#title-bar .title-line {
    width: auto;
    color: #7799cc;
}

#title-fill {
    width: 1fr;
    height: 1;
    color: #7799cc;
}

#view-button, #settings-button, #close-button {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #7799cc;
}

#view-button:hover, #view-button:focus,
#settings-button:hover, #settings-button:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#close-button:hover,
#close-button:focus {
    background: #202838;
    color: #f0a38a;
    text-style: none;
}

.dashboard-row {
    height: 1fr;
}

/* Voice and chat grow with the window up to a cap, then the bottom row takes the rest. */
#dashboard-top {
    min-height: 11;
    max-height: 24;
}

/* Sized to its boxes plus a scrollbar line when they don't all fit. */
#dashboard-middle {
    height: auto;
    scrollbar-size-horizontal: 1;
}

/* Just tall enough for the relationship box's contents; narrower than this pans instead. */
#dashboard-middle > .dashboard-box {
    width: 25%;
    height: 16;
    min-width: 34;
}

#dashboard-bottom {
    min-height: 8;
}

.dashboard-box {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: round #415575;
    border-title-color: #8f98a8;
}

#voice-column {
    width: 2fr;
    height: 1fr;
}

#voice-box {
    border-bottom: none;
}

#voice-controls {
    height: 1;
}

#voice-controls .voice-line {
    width: auto;
    color: #415575;
}

#voice-controls-fill {
    width: 1fr;
    height: 1;
    color: #415575;
}

/* The chat's latest activity summary, sitting on the voice box's bottom border. */
#dashboard-activity {
    width: auto;
    max-width: 60%;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #8f98a8;
}

#dashboard-activity.activity-error {
    color: #f0a38a;
}

#dashboard-speaker, #dashboard-mic {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#dashboard-speaker:hover, #dashboard-speaker:focus,
#dashboard-mic:hover, #dashboard-mic:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#dashboard-speaker.audio-muted, #dashboard-mic.audio-muted {
    color: #f0a38a;
}

#speaker-graph, #mic-graph {
    height: 1fr;
}

#speaker-graph {
    color: #8fcca6;
}

#mic-graph {
    color: #a6acd8;
}

#voice-axis, #dashboard-input-line {
    height: 1;
    color: #415575;
}

#relationship-meters {
    height: auto;
    color: #8fcca6;
}

.dashboard-label {
    margin-top: 1;
    color: #8f98a8;
}

.relationship-history {
    height: 2;
}

/* As wide as the meters' labels, so the graphs line up with the bars. */
.relationship-history-name {
    width: 12;
    height: 2;
    content-align: left bottom;
    color: #8f98a8;
}

.relationship-history BrailleGraph {
    color: #8fcca6;
}

#memory-kinds {
    height: auto;
    color: #a6acd8;
}

#memory-days {
    height: 3;
    color: #a6acd8;
}

#memory-pending {
    color: #415575;
}

#memory-pending.memory-waiting {
    color: #e6c07b;
}

#interest-strengths {
    height: auto;
    color: #7fb8d8;
}

/* Fills the rest of the box; scroll to read a long finding. */
#interest-finding-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#interest-finding {
    height: auto;
    color: #8f98a8;
}

#background-runs {
    height: auto;
    color: #d0d6e0;
}

/* Only as wide as its list; conversations takes the rest of the row. */
#background-box {
    width: auto;
}

#conversation-days {
    height: 7;
}

#background-box > Static {
    width: auto;
}

#relationship-tones {
    height: 1;
}

#dashboard-chat {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

ModelSettingsScreen {
    align: center middle;
    background: #141820 70%;
}

#model-settings {
    width: 48;
    height: auto;
    padding: 0 2 1 2;
    background: #141820;
    border: round #7799cc;
}

#model-settings-title {
    width: 1fr;
    margin: 1 0 0 0;
    color: #e0e6ef;
    text-style: bold;
}

.model-settings-label {
    margin: 1 0 0 0;
    color: #8f98a8;
}

#model-settings Select {
    width: 1fr;
}

#model-settings-close {
    margin: 1 0 0 0;
    width: 1fr;
}