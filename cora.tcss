Screen {
    background: #141820;
}

Screen > .screen--selection {
    color: #f3f6fb;
    background: #31557a;
}

#chat-panel {
    height: 1fr;
    background: #141820;
    border: round #7799cc;
    padding: 0 1;
}

#chat-output {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

#activity-panel {
    height: auto;
    margin: 1 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

#activity-panel > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #8f98a8;
    text-style: none;
}

#activity-panel > CollapsibleTitle:hover,
#activity-panel > CollapsibleTitle:focus {
    background: #202838;
    color: #e0e6ef;
}

#activity-panel.activity-error > CollapsibleTitle {
    color: #f0a38a;
}

#activity-panel > Contents {
    padding: 0;
}

#activity-output {
    height: 6;
    margin-top: 1;
    padding: 0 1;
    background: #10141b;
    color: #8f98a8;
    scrollbar-size: 1 1;
}

#status-bar {
    height: 1;
    margin: 0;
    padding: 0 1;
}

#chat-status {
    width: 1fr;
    height: 1;
    color: #8f98a8;
}

#mic-status {
    width: auto;
    height: 1;
    color: #8f98a8;
}

#input-frame {
    height: auto;
    margin-top: 0;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#chat-input {
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #141820;
    color: #e0e6ef;
    scrollbar-size: 1 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#chat-input:focus {
    border: none;
    background: #141820;
    background-tint: transparent;
}

#window-controls {
    height: 1;
    align: right top;
    padding: 0;
}

#close-button {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: #141820;
    color: #8f98a8;
    # offset: 1 0;
}

#close-button:hover,
#close-button:focus {
    background: #202838;
    color: #f0a38a;
}