Screen {
    background: #141820;
}

Screen > .screen--selection {
    color: #f3f6fb;
    background: #31557a;
}

#chat-panel, #dashboard-panel {
    height: 1fr;
    /* A window narrower than this cuts them off rather than squeezing text boxes under their own
       padding, where they can't lay out their text (a crash). */
    min-width: 50;
    background: #141820;
    border: round #7799cc;
    border-top: none;
    padding: 0 1;
}

#chat-row {
    height: 1fr;
}

/* The desk's chat in a box of its own: history, Activity, the controls and the message box. */
#desk-chat {
    width: 1fr;
    height: 1fr;
    min-width: 30;
}

#chat-output {
    width: 1fr;
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

#activity-panel {
    height: auto;
    margin: 1 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
}

#activity-panel > CollapsibleTitle {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #8f98a8;
    text-style: none;
}

#activity-panel > CollapsibleTitle:hover,
#activity-panel > CollapsibleTitle:focus {
    background: #202838;
    color: #e0e6ef;
}

#activity-panel.activity-error > CollapsibleTitle {
    color: #f0a38a;
}

#activity-panel > Contents {
    padding: 0;
}

#activity-output {
    height: 6;
    margin-top: 1;
    padding: 0 1;
    background: #10141b;
    color: #8f98a8;
    scrollbar-size: 1 1;
}

#status-bar {
    height: 1;
    margin: 0;
    padding: 0 1;
}

#chat-status {
    width: 1fr;
    /* Never narrower than its padding: squeezed to nothing, its text can't be laid out (a crash). */
    min-width: 5;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: transparent;
    content-align: left middle;
    text-align: left;
    text-style: none;
    text-opacity: 100%;
    color: #8f98a8;
}

#chat-status.state-active {
    color: #8fcca6;
}

#chat-status.state-active:hover, #chat-status.state-active:focus,
#chat-status.state-standby:hover, #chat-status.state-standby:focus {
    background: #202838;
}

#chat-status.state-standby {
    color: #a6acd8;
}

#chat-status.state-connecting, #chat-status.state-disconnecting {
    color: #e0c080;
}

#mic-status, #speaker-status, #wake-status {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0 0 0 2;
    padding: 0;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#mic-status:hover, #mic-status:focus,
#speaker-status:hover, #speaker-status:focus,
#wake-status:hover, #wake-status:focus {
    background: #202838;
    color: #e0e6ef;
}

#mic-status.audio-muted, #speaker-status.audio-muted {
    color: #f0a38a;
}

#wake-status.wake-listening {
    color: #8fcca6;
}

#speaker-status {
    width: 12;
    text-align: left;
}

#speaker-level {
    width: 8;
    height: 1;
    margin-left: 1;
    content-align: center middle;
    color: #8fcca6;
}

#speaker-level.audio-muted {
    color: #f0a38a;
}

#input-frame {
    height: auto;
    margin-top: 0;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

/* The image marker sits where the eye is while typing. */
#input-frame, #chat-box {
    border-subtitle-align: left;
}

#chat-input, #dashboard-input {
    height: 1;
    min-width: 10;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #141820;
    color: #e0e6ef;
    scrollbar-size: 1 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#chat-input:focus, #dashboard-input:focus {
    border: none;
    background: #141820;
    background-tint: transparent;
}

#title-bar {
    height: 1;
    background: #141820;
}

#title-bar .title-line {
    width: auto;
    color: #7799cc;
}

#title-fill {
    width: 1fr;
    height: 1;
    color: #7799cc;
}

#view-button, #settings-button, #close-button {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #7799cc;
}

#view-button:hover, #view-button:focus,
#settings-button:hover, #settings-button:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#close-button:hover,
#close-button:focus {
    background: #202838;
    color: #f0a38a;
    text-style: none;
}

.dashboard-row {
    height: 1fr;
}

/* Voice and chat grow with the window up to a cap, then the bottom row takes the rest. */
#dashboard-top {
    min-height: 11;
    max-height: 24;
}

/* Sized to its boxes plus a scrollbar line when they don't all fit. */
#dashboard-middle {
    height: auto;
    scrollbar-size-horizontal: 1;
}

/* Just tall enough for the feelings box's contents; narrower than this pans instead. */
#dashboard-middle > .dashboard-box {
    width: 20%;
    height: 16;
    min-width: 34;
}

#dashboard-bottom {
    min-height: 8;
    scrollbar-size-horizontal: 1;
}

/* From 5 to 26 weeks of the heatmap: initials, cells and gaps, plus border and padding. */
/* Under the feelings box, the width of a middle-row box. */
#relationship-box {
    width: 18%;
    min-width: 34;
}

#conversations-box {
    width: 18%;
    min-width: 16;
    max-width: 58;
}

/* Fr widths grow without limit once a scrolling row overflows, so only this box uses one. */
#context-box {
    width: 1fr;
    min-width: 40;
}

#context-placeholder {
    color: #415575;
}

#context-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#context-totals, #context-voice, #context-backend {
    height: auto;
}

#context-totals {
    color: #d0d6e0;
}

/* The voice model in the speaker graph's colour; the backend in the interests' blue. */
#context-voice {
    color: #8fcca6;
}

#context-backend {
    color: #7fb8d8;
}

.dashboard-box {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: round #415575;
    border-title-color: #8f98a8;
}

#voice-column {
    width: 2fr;
    height: 1fr;
}

/* Claude Code's sessions, between voice and chat while Cora listens for them; voice gives up the room. */
#claude-code-box {
    display: none;
}

#dashboard-top.with-claude-code #claude-code-box {
    display: block;
}

#dashboard-top.with-claude-code #voice-column {
    width: 1fr;
}

#dashboard-claude-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

/* Beside the chat's history: voice, with Claude Code's sessions below it while Cora listens. */
#side-panel {
    width: 46;
    height: 1fr;
}

#side-claude {
    display: none;
    height: 1fr;
}

#side-panel.with-claude-code #side-claude {
    display: block;
}

/* While Claude Code shows, voice keeps a small box and the sessions take the rest. */
#side-panel.with-claude-code #side-voice {
    height: 10;
}

#side-claude-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

/* Each Claude Code session in a list: a click follows it in a pop-up. */
.claude-session {
    margin-bottom: 1;
}

.claude-none {
    color: #415575;
}

#side-speaker-graph, #side-mic-graph {
    height: 1fr;
}

#side-speaker-graph {
    color: #8fcca6;
}

#side-mic-graph {
    color: #a6acd8;
}

#side-voice-axis {
    height: 1;
    color: #415575;
}

#voice-box {
    border-top: none;
    border-bottom: none;
}

#voice-header, #voice-controls {
    height: 1;
}

.voice-line {
    width: auto;
    color: #415575;
}

#voice-title {
    width: auto;
    padding: 0 1;
    color: #8f98a8;
}

/* At the voice box's top right: shows the connection state as the chat does and presses the same button. */
#dashboard-standby {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#dashboard-standby:hover, #dashboard-standby:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#dashboard-standby.state-active {
    color: #8fcca6;
}

#dashboard-standby.state-standby {
    color: #a6acd8;
}

#dashboard-standby.state-connecting, #dashboard-standby.state-disconnecting {
    color: #e0c080;
}

#voice-header-fill, #voice-controls-fill {
    width: 1fr;
    height: 1;
    color: #415575;
}

/* The chat's latest activity summary, sitting on the voice box's bottom border. */
#dashboard-activity {
    width: auto;
    max-width: 60%;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #8f98a8;
}

#dashboard-activity.activity-error {
    color: #f0a38a;
}

#dashboard-speaker, #dashboard-mic {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    line-pad: 1;
    border: none;
    background: transparent;
    text-style: none;
    color: #8f98a8;
}

#dashboard-speaker:hover, #dashboard-speaker:focus,
#dashboard-mic:hover, #dashboard-mic:focus {
    background: #202838;
    color: #e0e6ef;
    text-style: none;
}

#dashboard-speaker.audio-muted, #dashboard-mic.audio-muted {
    color: #f0a38a;
}

#speaker-graph, #mic-graph {
    height: 1fr;
}

#speaker-graph {
    color: #8fcca6;
}

#mic-graph {
    color: #a6acd8;
}

#voice-axis, #dashboard-input-line {
    height: 1;
    color: #415575;
}

#relationship-meters {
    height: auto;
    color: #8fcca6;
}

.dashboard-label {
    margin-top: 1;
    color: #8f98a8;
}

.relationship-history {
    height: 2;
}

/* As wide as the meters' labels, so the graphs line up with the bars. */
.relationship-history-name {
    width: 12;
    height: 2;
    content-align: left bottom;
    color: #8f98a8;
}

.relationship-history BrailleGraph {
    color: #8fcca6;
}

.feeling-row {
    height: 1;
}

/* As wide as the longest feeling's word, so the graphs line up. */
.feeling-name {
    width: 10;
    color: #415575;
}

.feeling-name.feeling-felt {
    color: #8f98a8;
}

#excitement-feeling { color: #e0b45c; }
#contentment-feeling { color: #8fcca6; }
#curiosity-feeling { color: #7fb8d8; }
#fulfilment-feeling { color: #c9a86a; }
#irritation-feeling { color: #e0905c; }
#hurt-feeling { color: #d27a7a; }

#feeling-latest-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#feeling-latest {
    height: auto;
}

#memory-kinds {
    height: auto;
    color: #a6acd8;
}

#memory-days {
    height: 3;
    color: #a6acd8;
}

#memory-pending {
    color: #415575;
}

#memory-pending.memory-waiting {
    color: #e6c07b;
}

#interest-strengths {
    height: auto;
    color: #7fb8d8;
}

/* Fills the rest of the box; scroll to read a long finding. */
#interest-finding-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#interest-finding {
    height: auto;
    color: #8f98a8;
}

#identity-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#identity-traits {
    height: auto;
    color: #d0d6e0;
}

#desires-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#desire-list {
    height: auto;
    color: #d0d6e0;
}

/* Beside the heatmap; a percentage, as only the context box may use a fr width in a scrolling row. */
#tasks-box {
    width: 22%;
    min-width: 34;
}

#tasks-scroll {
    height: 1fr;
    scrollbar-size: 1 0;
}

#task-list {
    height: auto;
    color: #d0d6e0;
}

.task-item {
    height: auto;
    margin: 0 0 1 0;
}

/* Dashboard text that opens in full when clicked. */
.openable:hover {
    background: #202838;
}

#background-runs {
    height: auto;
    color: #d0d6e0;
}

/* Only as wide as its list; conversations and context share the rest of the row. */
#background-box {
    width: auto;
}

#conversation-days {
    height: 7;
}

#background-box > Static {
    width: auto;
}

#relationship-tones {
    height: 1;
}

#dashboard-chat {
    height: 1fr;
    background: transparent;
    background-tint: transparent;
    scrollbar-size: 0 0;
}

ModelSettingsScreen {
    align: center middle;
    background: #141820 70%;
}

#model-settings {
    width: 78;
    height: auto;
    max-height: 95%;
    padding: 0 2;
    background: #141820;
    border: round #7799cc;
}

#model-settings-title {
    width: 1fr;
    margin: 1 0 0 0;
    color: #e0e6ef;
    text-style: bold;
}

#model-settings TabPane {
    padding: 0;
}

/* Small headings over groups of settings, in the dashboard's accent. */
.settings-heading {
    margin: 1 0 0 0;
    color: #7799cc;
    text-style: bold;
}

/* A setting's name, with its detail in a dimmer line underneath. */
.settings-field {
    width: 1fr;
    margin: 1 0 0 0;
}

.settings-label {
    color: #c8d0dc;
}

.settings-note {
    width: 1fr;
    margin: 1 0 0 0;
}

.settings-status, .service-reason {
    width: 1fr;
    margin: 0;
}

/* Compact inputs, selects and buttons: one line each, the buttons beside their input. */
#model-settings Input, #model-settings Select {
    width: 1fr;
}

#model-settings Input {
    background: #202838;
}

#model-settings Input:focus {
    background: #263248;
}

#model-settings SelectCurrent {
    background: #202838;
}

#model-settings Button {
    width: auto;
    min-width: 8;
    height: 1;
    padding: 0 2;
    background: #263248;
    color: #e0e6ef;
    text-style: none;
}

#model-settings Button:hover, #model-settings Button:focus {
    background: #34446a;
}

#model-settings Button:disabled {
    background: #1c2230;
    color: #5a6273;
}

.settings-row {
    height: auto;
    margin: 0;
}

.settings-row > * {
    margin: 0 0 0 1;
}

.settings-row > *:first-child {
    margin: 0;
}

/* A row of buttons only, such as signing in: apart from the field above. */
.settings-actions {
    margin: 1 0 0 0;
}

/* A switch on one line with its label beside it. */
#model-settings Switch {
    border: none;
    height: 1;
    padding: 0 1;
    background: transparent;
}

#model-settings Switch:focus {
    border: none;
    background-tint: #e0e6ef 8%;
}

.switch-row {
    height: auto;
    margin: 1 0 0 0;
}

.switch-row > Label {
    margin: 0 0 0 1;
}

.service-heading {
    height: auto;
    margin: 1 0 0 0;
}

.service-heading:hover {
    background: #1c2230;
}

.service-title {
    width: 18;
    color: #e0e6ef;
    text-style: bold;
}

.service-status {
    width: 1fr;
}

/* A service's details, indented under its row. */
.service-details {
    height: auto;
    display: none;
    padding: 0 0 1 2;
    border-left: vkey #2a3140;
}

#services-scroll, #general-scroll, #game-scroll, #claude-code-scroll {
    height: auto;
    max-height: 40;
    scrollbar-size-vertical: 1;
}

/* The models two to a row, so all of them and Close fit a small window. */
#models-grid {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 1 2;
    height: auto;
    margin: 1 0 0 0;
}

.model-cell {
    height: auto;
}

.signal-clients {
    height: auto;
    margin: 0 0 1 0;
}

.signal-clients Button.calls-on {
    color: #8fcf8f;
}

.signal-qr {
    width: auto;
    height: auto;
    margin: 1 0 0 0;
}

#email-signature {
    height: 6;
    border: none;
    background: #202838;
}

.service-tools-heading {
    margin: 1 0 0 0;
}

.service-tools {
    height: 16;
    border: round #2a3140;
    padding: 0 1;
}

.tool-row {
    height: auto;
    margin: 0;
}

.signal-clients .tool-row, .service-tools .tool-row {
    margin: 0 0 1 0;
}

.signal-clients .tool-row {
    margin: 0;
}

.tool-label {
    width: 1fr;
    margin: 0 0 0 1;
}

#model-settings-footer {
    height: auto;
    margin: 1 0 1 0;
}

#model-settings-hint {
    width: 1fr;
    color: #5a6273;
}

ConfirmScreen {
    align: center middle;
    background: #141820 70%;
}

#confirm-view {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 0 2 1 2;
    background: #141820;
    border: round #d7a06a;
}

#confirm-title {
    width: 1fr;
    margin: 1 0 1 0;
    color: #e0e6ef;
    text-style: bold;
}

#confirm-arguments {
    height: auto;
    max-height: 16;
    margin: 1 0 0 0;
}

#confirm-buttons {
    height: auto;
    margin: 1 0 0 0;
}

#confirm-buttons Button {
    width: 1fr;
}

#confirm-hint {
    margin: 1 0 0 0;
    color: #8f98a8;
}

ImageScreen {
    align: center middle;
    background: #141820 70%;
}

#image-view {
    width: 90%;
    height: 90%;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#image-view-caption, #image-view-hint {
    width: 1fr;
    color: #e0e6ef;
}

#image-view-hint {
    color: #8f98a8;
}

/* Every dashboard pop-up (the context box's included): centred over a dimmed dashboard. */
DetailScreen {
    align: center middle;
    background: #141820 70%;
}

#context-view {
    width: 90%;
    height: 90%;
    padding: 0 1;
    background: #141820;
    border: round #7799cc;
}

#context-view-title {
    width: 1fr;
    color: #e0e6ef;
}

#context-view-hint {
    width: 1fr;
    color: #8f98a8;
}

#context-view-text {
    height: 1fr;
    margin: 1 0;
    padding: 0;
    border: none;
    background: #141820;
    color: #d0d6e0;
}

#context-view-text:focus {
    border: none;
    background-tint: transparent;
}

/* A fixed area so the auto-sized image fits inside it, keeping its shape. */
#image-view-frame {
    height: 1fr;
}

#image-view-image {
    width: auto;
    height: auto;
}
#api-key-view {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 0 2 1 2;
    background: #141820;
    border: round #7799cc;
}

#api-key-title {
    width: 1fr;
    margin: 1 0 1 0;
    color: #e0e6ef;
    text-style: bold;
}

#api-key-help {
    color: #8f98a8;
}

#api-key-input {
    width: 1fr;
    margin: 1 0 0 0;
}

#api-key-problem {
    height: auto;
    margin: 1 0 0 0;
    color: #e07a7a;
}

#api-key-buttons {
    height: auto;
    margin: 1 0 0 0;
}

#api-key-buttons Button {
    width: 1fr;
}

#spend-chart {
    height: auto;
    margin: 1 0 0 0;
}
